{
  "name": "opencode-web-sidebar",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.22.3",
  "license": "MIT",
  "publisher": "ryjs",
  "author": {
    "name": "ryjs"
  },
  "homepage": "https://github.com/ryjs140/opencode-sidebar",
  "bugs": {
    "url": "https://github.com/ryjs140/opencode-sidebar/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryjs140/opencode-sidebar.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:opencode-web-sidebar.openPanel",
    "onCommand:opencode-web-sidebar.setPassword",
    "onCommand:opencode-web-sidebar.clearPassword",
    "onCommand:opencode-web-sidebar.startServer",
    "onCommand:opencode-web-sidebar.stopServer"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "opencode-web-sidebar",
          "title": "OpenCode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "opencode-web-sidebar": [
        {
          "type": "webview",
          "id": "opencode-web-sidebar.view",
          "name": "OpenCode"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode-web-sidebar.openPanel",
        "title": "%command.openPanel.title%",
        "category": "OpenCode",
        "icon": {
          "light": "media/icon.svg",
          "dark": "media/icon.svg"
        }
      },
      {
        "command": "opencode-web-sidebar.closePanel",
        "title": "%command.closePanel.title%",
        "category": "OpenCode"
      },
      {
        "command": "opencode-web-sidebar.focusPanel",
        "title": "%command.focusPanel.title%",
        "category": "OpenCode"
      },
      {
        "command": "opencode-web-sidebar.openFile",
        "title": "%command.openFile.title%",
        "category": "OpenCode"
      },
      {
        "command": "opencode-web-sidebar.setPassword",
        "title": "%command.setPassword.title%",
        "category": "OpenCode"
      },
      {
        "command": "opencode-web-sidebar.clearPassword",
        "title": "%command.clearPassword.title%",
        "category": "OpenCode"
      },
      {
        "command": "opencode-web-sidebar.startServer",
        "title": "%command.startServer.title%",
        "category": "OpenCode"
      },
      {
        "command": "opencode-web-sidebar.stopServer",
        "title": "%command.stopServer.title%",
        "category": "OpenCode"
      },
      {
        "command": "opencode-web-sidebar.openSettings",
        "title": "%command.openSettings.title%",
        "category": "OpenCode",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencode-web-sidebar.openPanel",
          "group": "navigation",
          "when": "!config.opencode-web-sidebar.hideButton"
        }
      ],
      "view/title": [
        {
          "command": "opencode-web-sidebar.openSettings",
          "when": "view == opencode-web-sidebar.view",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "opencode-web-sidebar.stopServer",
          "when": "opencode-web-sidebar.startedByUs"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode-web-sidebar.openPanel",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "opencode-web-sidebar.url": {
          "type": "string",
          "default": "http://localhost:4096",
          "description": "%config.url.description%"
        },
        "opencode-web-sidebar.servers": {
          "type": "array",
          "default": [
            {
              "id": "default",
              "url": "http://localhost:4096",
              "label": "Local Server",
              "isWsl": false,
              "isDefault": true,
              "serverCommand": "opencode web --port 4096"
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.servers.items.id.description%"
              },
              "url": {
                "type": "string",
                "description": "%config.servers.items.url.description%"
              },
              "label": {
                "type": "string",
                "description": "%config.servers.items.label.description%"
              },
              "isWsl": {
                "type": "boolean",
                "description": "%config.servers.items.isWsl.description%"
              },
              "isDefault": {
                "type": "boolean",
                "description": "%config.servers.items.isDefault.description%"
              },
              "serverCommand": {
                "type": "string",
                "description": "%config.servers.items.serverCommand.description%"
              },
              "username": {
                "type": "string",
                "description": "%config.servers.items.username.description%"
              },
              "authEnabled": {
                "type": "boolean",
                "description": "%config.servers.items.authEnabled.description%"
              }
            },
            "required": [
              "id",
              "url"
            ]
          },
          "description": "%config.servers.description%"
        },
        "opencode-web-sidebar.hideButton": {
          "type": "boolean",
          "default": false,
          "description": "%config.hideButton.description%"
        },
        "opencode-web-sidebar.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoReconnect.description%"
        },
        "opencode-web-sidebar.maxReconnectAttempts": {
          "type": "number",
          "default": 0,
          "description": "%config.maxReconnectAttempts.description%"
        },
        "opencode-web-sidebar.theme": {
          "type": "string",
          "default": "codex",
          "enum": [
            "codex",
            "vscode",
            "native",
            "beige"
          ],
          "enumItemLabels": [
            "%config.theme.enum.codex.label%",
            "%config.theme.enum.vscode.label%",
            "%config.theme.enum.native.label%",
            "%config.theme.enum.beige.label%"
          ],
          "enumDescriptions": [
            "%config.theme.enum.codex.description%",
            "%config.theme.enum.vscode.description%",
            "%config.theme.enum.native.description%",
            "%config.theme.enum.beige.description%"
          ],
          "description": "%config.theme.description%"
        },
        "opencode-web-sidebar.serverCommand": {
          "type": "string",
          "default": "opencode web --port 4096",
          "description": "%config.serverCommand.description%"
        },
        "opencode-web-sidebar.workspacePathStyle": {
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "wsl"
          ],
          "enumItemLabels": [
            "%config.workspacePathStyle.enum.none.label%",
            "%config.workspacePathStyle.enum.wsl.label%"
          ],
          "description": "%config.workspacePathStyle.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile && npm run lint",
    "test": "node --test out/WorkspaceNavigation.test.js out/OpenCodeProjectBootstrap.test.js out/OpenCodePanel.test.js out/SidebarTheme.test.js",
    "verify:nls": "node scripts/verify-nls.cjs",
    "verify:l10n": "node scripts/verify-l10n.cjs",
    "publish:marketplace": "vsce package && vsce publish",
    "publish:openvsx": "bash -c \"read -p 'Enter packaged filename: ' filename && read -sp 'Enter openvsx token: ' token && echo && npx ovsx publish \\\"$filename\\\" -p \\\"$token\\\"\"",
    "publish": "npm version minor --no-git-tag-version && npm run publish:marketplace && npm run publish:openvsx"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
